
pipeline {
    agent {
        label 'todo-ci-agent'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            steps {
                dir('backend') {
                    sh 'python -m pip install -r requirements.txt'
                    sh 'python -m pytest'
                }
            }
        }



        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarScanner'

                    withSonarQubeEnv('SonarQube') {
                        sh """
                            ${scannerHome}/bin/sonar-scanner
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    script {
                        def qualityGate = waitForQualityGate()

                        if (qualityGate.status != 'OK') {
                            error "SonarQube Quality Gate failed: ${qualityGate.status}"
                        }

                        echo "SonarQube Quality Gate passed!"
                    }
                }
            }
        }



        stage('Build Docker Images') {
            steps {
                sh 'docker build -t todo-backend:ci ./backend'
                sh 'docker build -t todo-frontend:ci ./frontend'
            }
        }


        stage('Trivy Vulnerability Scan') {
            steps {
                sh '''
                    echo "Scanning backend image..."

                    docker run --rm \
                        -v /var/run/docker.sock:/var/run/docker.sock \
                        aquasec/trivy:latest \
                        image --scanners vuln \
                        --severity HIGH,CRITICAL \
                        --ignore-unfixed \
                        --exit-code 1 \
                        todo-backend:ci

                    echo "Scanning frontend image..."

                    docker run --rm \
                        -v /var/run/docker.sock:/var/run/docker.sock \
                        aquasec/trivy:latest \
                        image --scanners vuln \
                        --severity HIGH,CRITICAL \
                        --ignore-unfixed \
                        --exit-code 1 \
                        todo-frontend:ci
                '''
            }
        }

        stage('Publish to Artifact Registry') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'gcp-artifact-registry-key',
                        variable: 'GCP_KEY_FILE'
                    )
                ]) {
                    sh '''
                        set -eu

                        PROJECT_ID="ccproject-ae950"
                        REGION="asia-south1"
                        REPOSITORY="todo-images"
                        REGISTRY="${REGION}-docker.pkg.dev"
                        IMAGE_TAG="$(git rev-parse --short=12 HEAD)"

                        # Authenticate to Google Cloud
                        gcloud auth activate-service-account \
                            --key-file="$GCP_KEY_FILE"

                        gcloud config set project "$PROJECT_ID"

                        # Authenticate Docker to Artifact Registry
                        gcloud auth print-access-token |
                            docker login \
                                -u oauth2accesstoken \
                                --password-stdin \
                                "https://${REGISTRY}"

                        # Tag the already-built images with the Git SHA
                        docker tag todo-backend:ci \
                            "${REGISTRY}/${PROJECT_ID}/${REPOSITORY}/todo-backend:${IMAGE_TAG}"

                        docker tag todo-frontend:ci \
                            "${REGISTRY}/${PROJECT_ID}/${REPOSITORY}/todo-frontend:${IMAGE_TAG}"

                        # Push both images
                        docker push \
                            "${REGISTRY}/${PROJECT_ID}/${REPOSITORY}/todo-backend:${IMAGE_TAG}"

                        docker push \
                            "${REGISTRY}/${PROJECT_ID}/${REPOSITORY}/todo-frontend:${IMAGE_TAG}"

                        # Remove cached registry credentials from this agent
                        docker logout "https://${REGISTRY}"
                        gcloud auth revoke --all --quiet
                    '''
                }
            }
        }
        stage('Update GitOps Repository') {
        steps {
            script {
                // Use the same commit SHA as the Docker image tag
                def imageTag = sh(
                    script: 'git rev-parse --short=12 HEAD',
                    returnStdout: true
                ).trim()

                dir('gitops') {
                    // Clone the private GitOps repository
                    git branch: 'main',
                        credentialsId: 'gitops-repo-write',
                        url: 'https://github.com/warrior2k0404-source/todo-gitops.git'

                    // Make Git credentials available to the shell
                    withCredentials([
                        gitUsernamePassword(
                            credentialsId: 'gitops-repo-write',
                            gitToolName: 'Default'
                        )
                    ]) {
                        sh """
                            set -eu

                            # Update the desired image version
                            sed -i -E \
                                's/^imageTag:.*/imageTag: ${imageTag}/' \
                                todo-helm/values.yaml

                            # Configure Git commit identity
                            git config user.name "Jenkins"
                            git config user.email "jenkins@localhost"

                            # Commit and push only if the tag changed
                            if git diff --quiet -- todo-helm/values.yaml; then
                                echo "Image tag is already up to date"
                            else
                                git add todo-helm/values.yaml

                                git commit \
                                    -m "Update Todo image tag to ${imageTag}"

                                git push origin HEAD:main
                            fi
                        """
                    }
                }
            }
         }
       }


    }
}



post {
    always {
        script {
            def buildStatus = currentBuild.currentResult ?: 'SUCCESS'

            def emailSubject = "[Jenkins] Todo CI/CD - ${buildStatus} - Build #${BUILD_NUMBER}"

            def emailBody = """
                <html>
                <body>
                    <h2>Todo Application - CI/CD Pipeline Report</h2>

                    <p><b>Build Status:</b> ${buildStatus}</p>
                    <p><b>Job Name:</b> ${JOB_NAME}</p>
                    <p><b>Build Number:</b> #${BUILD_NUMBER}</p>
                    <p><b>Git Commit:</b> ${env.GIT_COMMIT ?: 'Not available'}</p>

                    <p>
                        <b>Build URL:</b>
                        <a href="${BUILD_URL}">${BUILD_URL}</a>
                    </p>

                    <hr/>
                    <p>This is an automated Jenkins notification.</p>
                </body>
                </html>
            """

            try {
                emailext(
                    to: 'YOUR_EMAIL@gmail.com',
                    subject: emailSubject,
                    body: emailBody,
                    mimeType: 'text/html'
                )
            } catch (Exception e) {
                echo "Email notification failed: ${e.message}"
            }
        }
    }
}
